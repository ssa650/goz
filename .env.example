FAL_KEY=
PORT=3210
GOZ_DEMO=0
# adaptive story (/adaptive.html)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
GOZ_GAZE=gazekit
GOZ_EEG=muse
GOZ_MAX_SCENES=4
GOZ_ANALYZE_AT=0.7
# Startup connects Muse, collects 60 clean EEG seconds, calibrates Gazekit,
# then enables Generate. Demo mode explicitly skips real hardware checks.
GOZ_REQUIRE_SENSORS=1
GOZ_GAZE_CAMERA=0
# GOZ_GAZEKIT_DIR=/absolute/path/to/gazekit
# GOZ_GAZEKIT_PYTHON=/absolute/path/to/python
# GOZ_MUSE_ADDRESS=your-device-address
# GOZ_MUSE_NAME=Muse-device-name
