FAL_KEY=
PORT=3210
GOZ_DEMO=0
# Adaptive story: http://127.0.0.1:3210/adaptive.html
# Bounded adaptation uses local rules; no remote decision model is called.
GOZ_GAZE=gazekit
GOZ_EEG=muse
GOZ_MAX_SCENES=4
# Timing is scheduled from measured readiness; there is no fixed 70% trigger.
# Use an absolute path for a separate local data/calibration directory.
# GOZ_DATA_DIR=/absolute/path/to/goz-data
GOZ_VIEWER_PROFILE=default
GOZ_GAZE_PORT=5590
# Optional index only for a NEW calibration (0 FaceTime, 1 iPhone on this Mac).
# Saved calibration resolves the recorded camera device identity.
# GOZ_GAZE_CAMERA=1
# GOZ_GAZEKIT_DIR=/absolute/path/to/gazekit
# GOZ_GAZEKIT_PYTHON=/absolute/path/to/python

# Default Muse route: connect on the phone in Mind Monitor, then send OSC
# to this Mac on the same Wi-Fi. Stream horseshoe, alpha_absolute and
# beta_absolute. Optional blink, jaw_clench and raw EEG improve rejection.
GOZ_MINDMONITOR_PORT=5000
# GOZ_MINDMONITOR_PHONE_IP=optional-phone-ip-to-pin-sender
# GOZ_EEG=muse uses a local MuseLSL/Bleak bridge and 60s clean baseline.
# Close other apps connected to the headset before direct Bluetooth use.
# GOZ_MUSE_ADDRESS=your-device-address
# GOZ_MUSE_NAME=Muse-device-name
# Missing/noisy EEG keeps gaze-only mode available. Set 1 only for a
# strict hardware rehearsal that blocks without BOTH calibrated sensors.
GOZ_REQUIRE_SENSORS=0

# Florence dense-region captions + local identity reference verification.
# Default: 0.5fps, at most 8 frames per clip, cached by clip/schema.
GOZ_TRACKER=fal
# Optional independent visual identity verification on SCENE frames only:
# one cached request per clip, <=8 frames +2 character reference crops.
# auto uses an existing configured key/model; off keeps local reference checks.
GOZ_IDENTITY=auto
OPENAI_API_KEY=
# Set to a Responses image-input model verified for your existing account.
# GOZ_IDENTITY_MODEL=your-configured-model
# OPENAI_MODEL is accepted as a legacy fallback for identity verification only.
# Late generation shows a labelled held-frame bridge; no hidden replay.
# Free rehearsal only: GOZ_DEMO=1 GOZ_GAZE=sim GOZ_EEG=sim
# GOZ_SIM_FAVORITE=1
# GOZ_SIM_BIAS=0.95

# Repeatable rehearsal input (never real gaze):
# GOZ_SIM_SEED=acceptance
