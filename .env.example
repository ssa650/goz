FAL_KEY=
PORT=3210
GOZ_DEMO=0
# adaptive story (/adaptive.html)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
GOZ_GAZE=gazekit
GOZ_EEG=mindmonitor
GOZ_MAX_SCENES=4
GOZ_ANALYZE_AT=0.7
# Startup opens Gazekit camera selection automatically and calibrates
# Gazekit first, then receives Mind Monitor OSC with 10 good readings.
# Phone and Mac must share Wi-Fi. Connect Muse in Mind Monitor on the phone.
GOZ_MINDMONITOR_PORT=5000
# GOZ_MINDMONITOR_PHONE_IP=optional-phone-ip-to-pin-sender
# GOZ_EEG=muse restores the direct Bluetooth/LSL 60-second baseline.
# Demo mode explicitly skips real hardware checks.
GOZ_REQUIRE_SENSORS=1
# GOZ_GAZEKIT_DIR=/absolute/path/to/gazekit
# GOZ_GAZEKIT_PYTHON=/absolute/path/to/python
# GOZ_MUSE_ADDRESS=your-device-address
# GOZ_MUSE_NAME=Muse-device-name
